
 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your cars</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <h1>Your cars</h1>
<div class="container">    
 
    <ul>
    <% vehicles.forEach( el => { %>

            <li class='carItem' data-id='<%=el._id%>'>
                <!-- <span class='<%= el.completed === true ? 'completed' : 'not'%>'><%= el.carItem %></span>
                <span class='del'> Delete </span> -->
                <div class="col">
                <img src="<%= el.imageSrc %>" alt="<%= el.carDesc %>">
                </div>
                <p><%= el.carDesc %></p>
                <h2 class="fg-primary"><%= el.carName %></h2>


            </li>
    <% }) %>    
    </ul>

</div>

    <h2><%= user.userName %> has <%= left %> things left to do.</h2>

    <form action="/cars/addCar" method='POST'>
        <input type="text" placeholder="Car Name" name="carItem">
        <input type="text" placeholder="Car Image Link" name="carImage">
        <input type="text" placeholder="Short Car Desc." name="carDesc">
        <input type="submit">
    </form>

 
    <a href="/logout">Logout</a>


    <script src="js/main.js"></script>
    
</body>
</html>

